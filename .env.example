# Configuración MiPizarra — Entorno Local / Servidor
BIND_IP=0.0.0.0
OLLAMA_MODEL=qwen3:4b-instruct
# qwen3:4b (con thinking) filtra razonamiento en inglés dentro de /generar y /reglamento
# y "think": False no lo evita de forma fiable. qwen3:4b-instruct no tiene modo thinking.
OLLAMA_MODEL_SESION=qwen3:4b-instruct
# Límites de memoria RAM de los contenedores (los valores por defecto son los del servidor, que va justo de RAM).
# En un PC con modelos grandes (p. ej. gemma4:12b, 8 GB) sube el de Ollama: OLLAMA_MEM_LIMIT=16g
# OLLAMA_MEM_LIMIT=4g
# API_MEM_LIMIT=768m
# FRONTEND_MEM_LIMIT=128m
# Modelo de embeddings de la búsqueda (RAG). Si lo cambias hay que reindexar:
#   docker exec mipizarra-api python /app/tools/indexar_colecciones.py
# EMBED_MODEL=qwen3-embedding:0.6b
# Los PDF de terceros están aislados del sistema: la API no los monta ni los consulta nunca. El RAG usa solo los
# documentos propios (data/teoria y data/reglamento, en .md).
# Modelo del modo reglamento (opcional; por defecto, el de sesión). gemma4:12b acierta más en reglamento
# (12/12 en las pruebas) que qwen3:4b-instruct (9/12) y cabe a la vez en 16 GB de VRAM.
# OLLAMA_MODEL_REGLAMENTO=gemma4:12b

# Frontend Django
DJANGO_SECRET_KEY=dev-secret-key-local-mipizarra
DJANGO_DEBUG=True
# Añade aquí tu dominio si lo publicas (separado por espacios)
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 0.0.0.0

# Seguridad de comunicación interna (en local se deja vacío)
MIPIZARRA_INTERNAL_SECRET=
